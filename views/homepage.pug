doctype html
html
  head
    title= pageTitle
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Events Table

    a(href="/update-cobj") Add/Update this table

    table.custom-table
      thead
        tr
          th Name
          th Venue
          th Start Date
      tbody
        if records && records.length
          each record in records
            tr
              td= record.properties.name
              td= record.properties.venue
              td= record.properties.start_date
        else
          tr
            td(colspan="3") No records found.