doctype html
html
  head
    title= pageTitle
    link(rel="stylesheet", href="public/css/style.css")
  body
    h1 Custom Object Table

    a.add-link(href="/update-cobj") Add to this table

    table.custom-table
      thead
        tr
          th Name
          th Publisher
          th Price
      tbody
        if records && records.length
          each record in records
            tr
              td= record.properties.name
              td= record.properties.publisher
              td= record.properties.price
        else
          tr
            td(colspan="3") No records found.